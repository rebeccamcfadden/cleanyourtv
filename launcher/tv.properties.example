# Build settings for this TV (docs/rework.md, Build settings file).
#
# Copy this file to launcher/tv.properties and edit the copy: tv.properties is gitignored, so your location
# never ends up in git. While tv.properties is missing the build reads this example instead.

# Where the weather on Home is for, in decimal degrees (north and east are positive). Open-Meteo, no key needed.
# The default is Stockholm. Launcher settings on the TV can choose another place, which then wins over these.
latitude=59.3293
longitude=18.0686

# C for Celsius or F for Fahrenheit. Android TV has no temperature setting, so the launcher can't ask the TV.
# Launcher settings on the TV can override it too.
temperature_unit=C

# Optional: your TMDB "API Read Access Token" (the long v4 token from themoviedb.org, Settings, API), for the real
# catalogue: titles, artwork, cast, episodes and search. Leave it out and the launcher builds with the mock
# catalogue instead, which works offline. Never commit a token: keep it in tv.properties only.
#tmdb_api_key=
