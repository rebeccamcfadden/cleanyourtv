# Build settings for this TV (docs/rework.md, Build settings file).
#
# Copy this file to launcher/tv.properties and edit the copy: tv.properties is gitignored, so your location
# never ends up in git. While tv.properties is missing the build reads this example instead.

# Where the weather on Home is for, in decimal degrees (north and east are positive). Open-Meteo, no key needed.
# The default is Stockholm. Launcher settings on the TV can choose another place, which then wins over these.
latitude=59.3293
longitude=18.0686
# Optional: the city's name, for the quick-settings Weather row ("Stockholm · °C") while no place is chosen on the TV.
# Leave it out and the row says Default. Written as it is spelled (the file is read as UTF-8), at most 60 characters.
weather_city=Stockholm

# C for Celsius or F for Fahrenheit. Android TV has no temperature setting, so the launcher can't ask the TV.
# Launcher settings on the TV can override it too.
temperature_unit=C

# Optional: your TMDB "API Read Access Token" (the long v4 token from themoviedb.org, Settings, API), for the real
# catalogue: titles, artwork, cast, episodes and search. Leave it out and the launcher builds with the mock
# catalogue instead, which works offline. Never commit a token: keep it in tv.properties only.
#tmdb_api_key=

# Optional rent and buy prices (BACKLOG.md, Streaming availability and prices). Without a key the launcher shows where
# a title can be rented or bought, and prices only from Apple's keyless iTunes lookup. Each key is a free plan, for
# non-commercial use with attribution in the launcher; the launcher stops below each quota (no paid plans).
# Watchmode, https://api.watchmode.com (free plan: 2,500 credits a month; the launcher stops at 2,300):
#watchmode_api_key=
# Movie of the Night's Streaming Availability API, https://developers.movieofthenight.com (free plan: 1,000 requests
# a month; the launcher stops at 900). streaming_availability_api_key is read too, under the API's other name.
#movie_of_the_night_api_key=
