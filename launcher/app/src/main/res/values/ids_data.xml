<?xml version="1.0" encoding="utf-8"?>
<!-- View tags the data layer's UI kit reads (Art, Kit). -->
<resources>
    <!-- The artwork an ImageView is waiting for, so a late decode never lands in a view that moved on. -->
    <item name="art_key" type="id" />
    <!-- A Kit button's or chip's parts and state, for setOn, setSelected and setLabel. -->
    <item name="kit_label" type="id" />
    <item name="kit_icon" type="id" />
    <item name="kit_check" type="id" />
    <item name="kit_icon_only" type="id" />
    <!-- The Title on a title card, for the hold-OK title menu (TitleMenu). -->
    <item name="kit_title" type="id" />
    <!-- A title card's list line, brought up to date in place by the title menu (Kit.refreshTitleCard). -->
    <item name="kit_provenance" type="id" />
    <!-- A menu row's tick (MenuPanel.Row.check). -->
    <item name="menu_check" type="id" />
    <!-- The keys of a hold-OK tile's row, nearest first: focus lands there when the tile has gone (TileMenu.close). -->
    <item name="menu_near" type="id" />
</resources>
