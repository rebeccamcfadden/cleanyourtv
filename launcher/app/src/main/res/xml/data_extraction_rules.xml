<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (targetSdk 31+): allowBackup="false" no longer covers device-to-device transfer, so nothing goes in
     either. The launcher's files hold this TV's setup and the TMDB account's session. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
