<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="32dp" android:paddingEnd="32dp"
    android:paddingTop="16dp" android:paddingBottom="12dp">
    <TextView android:id="@+id/searchHeading" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textSize="26sp" android:textColor="#FFFFFF" />
    <TextView android:id="@+id/searchNotice" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/demo_notice" android:textSize="13sp" android:textColor="#9ED9C4"
        android:layout_marginBottom="6dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <EditText android:id="@+id/query" android:layout_width="0dp" android:layout_height="52dp"
            android:layout_weight="1" android:hint="@string/query_hint" android:inputType="text"
            android:maxLines="1" android:imeOptions="actionSearch" android:selectAllOnFocus="false"
            android:autofillHints="" android:textSize="18sp" android:textColor="#FFFFFF"
            android:textColorHint="#ADB8C0" />
        <Button android:id="@+id/search" style="@style/SearchButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/search" />
        <Button android:id="@+id/settings" style="@style/SearchButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/region" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="13sp" android:textColor="#ADB8C0" />
        <CheckBox android:id="@+id/simulateError" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="@string/simulate_error" android:textColor="#FFFFFF" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/empty_query" android:textSize="15sp" android:textColor="#DEE5E9"
        android:accessibilityLiveRegion="polite" android:paddingBottom="8dp" />
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true"
        android:visibility="gone" />
    <Button android:id="@+id/retry" style="@style/SearchButton" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/retry" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/results"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:padding="5dp" android:descendantFocusability="afterDescendants" />
</LinearLayout>
