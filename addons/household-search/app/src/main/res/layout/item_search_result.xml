<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/resultCard" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_margin="6dp" android:padding="12dp"
    android:background="@drawable/focus_button" android:focusable="true" android:clickable="true">
    <FrameLayout android:layout_width="match_parent" android:layout_height="96dp" android:background="#172127">
        <ImageView android:id="@+id/artwork" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/placeholderIcon"
            android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
            android:src="@drawable/icon" android:importantForAccessibility="no" />
        <TextView android:id="@+id/placeholderLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:gravity="center" android:text="@string/artwork_placeholder"
            android:textSize="12sp" android:textColor="#ADB8C0" />
    </FrameLayout>
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="52dp"
        android:textSize="19sp" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/metadata" android:layout_width="match_parent" android:layout_height="40dp"
        android:textSize="12sp" android:textColor="#CED8DE" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/providers" android:layout_width="match_parent" android:layout_height="34dp"
        android:textSize="12sp" android:textColor="#ADB8C0" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/included" android:layout_width="match_parent" android:layout_height="30dp"
        android:text="@string/included" android:textSize="12sp" android:textColor="#B9FFE4"
        android:maxLines="2" android:ellipsize="end" />
    <ProgressBar android:id="@+id/playbackProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:max="100"
        android:visibility="gone" />
</LinearLayout>
