<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="28dp" android:paddingEnd="28dp"
        android:paddingTop="14dp" android:paddingBottom="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="24sp" android:textColor="#FFFFFF" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/openSearch" style="@style/SearchButton" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="52dp" android:text="@string/home_search" />
            <Button android:id="@+id/refreshHome" style="@style/SearchButton" android:layout_width="wrap_content"
                android:layout_height="52dp" android:text="@string/refresh" />
            <Button android:id="@+id/openDemo" style="@style/SearchButton" android:layout_width="wrap_content"
                android:layout_height="52dp" android:text="@string/demo_catalog" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/native_search_notice" android:textColor="#ADB8C0" android:textSize="12sp" />
        <TextView android:id="@+id/homeStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/native_loading"
            android:textColor="#9ED9C4" android:textSize="12sp" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/allowListings" style="@style/SearchButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/allow_listings" android:visibility="gone" />
        <ProgressBar android:id="@+id/homeLoading" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/continue_watching" android:textSize="20sp" android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />
        <TextView android:id="@+id/resumeEmpty" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/no_resume_entries"
            android:textColor="#ADB8C0" android:textSize="14sp" android:padding="8dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/resumeRow"
            android:layout_width="match_parent" android:layout_height="188dp" android:padding="4dp"
            android:clipToPadding="false" android:nestedScrollingEnabled="false" android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/apps" android:textSize="20sp" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/appsEmpty" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/no_apps"
            android:textColor="#ADB8C0" android:textSize="14sp" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/appsRow"
            android:layout_width="match_parent" android:layout_height="188dp" android:padding="4dp"
            android:clipToPadding="false" android:nestedScrollingEnabled="false" />
    </LinearLayout>
</ScrollView>
