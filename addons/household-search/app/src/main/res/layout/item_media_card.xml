<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mediaCard" android:layout_width="212dp" android:layout_height="match_parent"
    android:layout_margin="4dp" android:padding="8dp" android:orientation="vertical"
    android:focusable="true" android:clickable="true" android:background="@drawable/focus_button">
    <FrameLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="#172127">
        <ImageView android:id="@+id/artwork" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/placeholderIcon" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_gravity="center" android:src="@drawable/icon" android:importantForAccessibility="no" />
        <TextView android:id="@+id/placeholderLabel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="bottom" android:gravity="center"
            android:text="@string/artwork_placeholder" android:textSize="11sp" android:textColor="#ADB8C0" />
    </FrameLayout>
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="40dp"
        android:textSize="16sp" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/metadata" android:layout_width="match_parent" android:layout_height="28dp"
        android:textSize="11sp" android:textColor="#CED8DE" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/providers" android:layout_width="match_parent" android:layout_height="18dp"
        android:textSize="11sp" android:textColor="#ADB8C0" android:maxLines="1" android:ellipsize="end" />
    <ProgressBar android:id="@+id/playbackProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:max="100" />
</LinearLayout>
