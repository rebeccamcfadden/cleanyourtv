<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#345B50" />
            <stroke android:width="3dp" android:color="#B9FFE4" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#242E38" />
            <stroke android:width="1dp" android:color="#4A5964" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
